# Copie vers .env (jamais commité) puis remplit avec TA session navigateur
# Exemple avec placeholders — remplace par tes valeurs (DevTools > Cookies).
OD_TENANT=votre-tenant-my.sharepoint.com
OD_PERSONAL_PATH=/personal/prenom_nom_domaine_fr
OD_DRIVE_ID=<DRIVE_ID>
OD_LIST_ID_DOCS=<LIST_ID_DOCS>
# Cookies copiés depuis DevTools (F12 > Application > Cookies > ton tenant).
# Format: "FedAuth=...; rtFa=...; ..."  -- expire, à renouveler à chaque session.
OD_COOKIES=
# Optionnel: si vide, le client fait POST /_api/contextinfo pour l'obtenir
OD_DIGEST=
# Optionnel: OD_COOKIES_FILE=/path/cookies.txt (alternative à OD_COOKIES)
# Optionnel: délai min entre appels (s), anti-rafale
OD_MIN_DELAY=0.2
# Serveur local (server.py): clé requise
OD_SERVER_KEY=change-moi
# Upload auto: seuil Mo pour basculer single-shot -> chunked (100 Mo prouvés en 1 appel)
OD_LARGE_THRESHOLD_MB=100
